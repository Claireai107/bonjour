# Anthropic API 키 — 검진표 OCR을 Claude 비전으로 처리 (정확도 대폭 향상).
# https://platform.claude.com 에서 발급. 없으면 기기 내 tesseract OCR로 폴백.
ANTHROPIC_API_KEY=

# Gemini 비전 OCR — aistudio.google.com 에서 무료 발급 (Claude 키 없을 때 사용)
GEMINI_API_KEY=

# 카카오 REST API 키 — developers.kakao.com 앱의 'REST API 키'
# 현재위치→주소 변환, 내 주변 보건소 검색에 사용. 없으면 데모 데이터로 동작.
KAKAO_REST_API_KEY=

# ─────────── 회원가입 DB · 인증 (신규) ───────────

# Supabase — 없으면 서버 메모리로 동작(발표·로컬 시연용, 재시작 시 초기화)
# supabase.com 프로젝트 → Settings → API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 암호화 키 — 아무 긴 문자열이나 넣으면 SHA-256으로 32바이트 키로 정규화됨
# 운영에서는 반드시 새로 만들어 Vercel 환경변수(=DB와 분리된 저장소)에 둘 것
APP_ENCRYPTION_KEY=
APP_HASH_PEPPER=

# 인증번호 발송 방식 — mock: 화면에 코드 표시(무료) / sms: 실제 문자 발송
SMS_MODE=mock

# 점검 모드 — 1 이면 모든 화면이 '점검 중' 안내로 바뀜 (롤백 중에만 사용)
MAINTENANCE_MODE=
